      <button id="close-auth-modal" class="absolute top-4 right-4 p-2 rounded-full hover:bg-white/10 transition-colors" style="color: var(--muted);">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
