                <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center">
                    <i data-lucide="zap" class="text-white w-5 h-5"></i>
                </div>
                <span class="font-display font-bold text-xl">WaslaTech</span>
            </div>
            <div class="text-muted text-sm">© 2026 WaslaTech. All rights reserved.</div>
            <div class="flex gap-6">
                <a href="#" class="text-muted hover:text-blue-500 transition-colors"><i data-lucide="twitter" class="w-5 h-5"></i></a>
                <a href="#" class="text-muted hover:text-blue-500 transition-colors"><i data-lucide="linkedin" class="w-5 h-5"></i></a>
                <a href="#" class="text-muted hover:text-blue-500 transition-colors"><i data-lucide="github" class="w-5 h-5"></i></a>
            </div>
