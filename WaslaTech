    <!-- Contact Section -->
    <section id="contact" class="py-32 px-6 relative">
        <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-20 items-center">
            <div class="reveal">
                <h2 class="font-display font-bold text-4xl lg:text-6xl mb-8 leading-tight">Ready to Transform Your <span class="text-gradient">Customer Experience?</span></h2>
                <p class="text-muted text-lg mb-10">Join 500+ businesses that trust WaslaTech to power their WhatsApp communications.</p>
                <div class="space-y-6">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-500">
                            <i data-lucide="mail" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <div class="font-bold">Email Us</div>
                            <div class="text-muted">hello@waslatech.com</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-500">
                            <i data-lucide="map-pin" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <div class="font-bold">Visit Us</div>
                            <div class="text-muted">Cairo, Egypt</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="glass rounded-[2rem] p-10 reveal" style="transition-delay: 200ms;">
                <form id="contact-form" class="space-y-6">
                    <div class="grid sm:grid-cols-2 gap-6">
                        <div class="space-y-2">
                            <label class="text-sm font-bold text-muted uppercase tracking-widest">First Name</label>
                            <input type="text" required class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-4 focus:outline-none focus:border-blue-500 transition-all" placeholder="John">
                        </div>
                        <div class="space-y-2">
                            <label class="text-sm font-bold text-muted uppercase tracking-widest">Last Name</label>
                            <input type="text" required class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-4 focus:outline-none focus:border-blue-500 transition-all" placeholder="Doe">
                        </div>
                    </div>
                    <div class="space-y-2">
                        <label class="text-sm font-bold text-muted uppercase tracking-widest">Work Email</label>
                        <input type="email" required class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-4 focus:outline-none focus:border-blue-500 transition-all" placeholder="john@company.com">
                    </div>
                    <div class="space-y-2">
                        <label class="text-sm font-bold text-muted uppercase tracking-widest">Message</label>
                        <textarea rows="4" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-4 focus:outline-none focus:border-blue-500 transition-all" placeholder="How can we help?"></textarea>
                    </div>
                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-5 rounded-2xl font-bold transition-all shadow-xl shadow-blue-500/25 btn-premium">Send Message</button>
